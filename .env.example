
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
VITE_API_BASE_URL=http://localhost:1339/api
VITE_GOOGLE_GENAI_API_KEY=YOUR_GOOGLE_GENAI_API_KEY
VITE_OPENAI_HUGGINGFACE_API_KEY=YOUR_OPENAI_HUGGINGFACE_API_KEY
VITE_OPENAI_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Resource Resolution Services
# YouTube Data API v3 - Get it from Google Cloud Console
VITE_YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# Google Custom Search API - Get it from Google Cloud Console
VITE_GOOGLE_SEARCH_API_KEY=YOUR_GOOGLE_SEARCH_API_KEY

# Google Custom Search Engine ID - Create a custom search engine at https://cse.google.com/
VITE_GOOGLE_SEARCH_ENGINE_ID=YOUR_GOOGLE_SEARCH_ENGINE_ID

# Instructions to get API keys:
# 
# 1. YouTube Data API:
#    - Go to https://console.cloud.google.com/
#    - Enable YouTube Data API v3
#    - Create credentials (API key)
#    - Restrict the key to YouTube Data API v3
#
# 2. Google Custom Search API:
#    - Same Google Cloud Console
#    - Enable Custom Search API
#    - Use the same API key or create a new one
#    - Create a Custom Search Engine at https://cse.google.com/
#    - Copy the Search Engine ID
